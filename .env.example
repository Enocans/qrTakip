# Copy to .env. Never commit credentials.
SECRET_KEY=replace-with-a-long-random-value
PUBLIC_URL=https://your-app.example.com
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 with HTTPS in production.
# DATA_DIR=/var/data
# Vercel: connect Neon/Supabase Postgres and set DATABASE_URL.
# Local use without DATABASE_URL keeps SQLite.
DATABASE_URL=

# Optional: a fixed teacher number; if empty the student enters it.
TEACHER_PHONE=

# Twilio WhatsApp sender and approved Content Template
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_DAILY_CONTENT_SID=
